# Mealie API Configuration
# Replace these values with your own Mealie instance details

# The base URL of your Mealie instance (including protocol and port if needed)
MEALIE_BASE_URL=https://your-mealie-instance.com

# Your Mealie API key
# Generate this from your Mealie account settings
MEALIE_API_KEY=your-mealie-api-key

# Optional: address under which callers reach Mealie, used for the image URLs
# returned by get_recipe_image_url / get_recipe_thumbnail_url. Only needed if
# MEALIE_BASE_URL is an internal address. Defaults to MEALIE_BASE_URL.
# MEALIE_PUBLIC_URL=https://your-mealie-instance.com

LOG_LEVEL=INFO
